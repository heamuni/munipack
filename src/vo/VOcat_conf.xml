<TR><TD>GSC</TD><TD>I/353</TD><TD>RA_ICRS</TD><TD>DE_ICRS</TD><TD>pmRA</TD><TD>pmDE</TD><TD>EpRA</TD><TD>EpDE</TD><TD>Vmag</TD></TR>
<TR><TD>Hipparcos</TD><TD>I/239</TD><TD>RAICRS</TD><TD>DEICRS</TD><TD>pmRA</TD><TD>pmDE</TD><TD>EpRA</TD><TD>EpDE</TD><TD>Vmag</TD></TR>
<TR><TD>Tycho</TD><TD>I/259</TD><TD>RA(ICRS)</TD><TD>DE(ICRS)</TD><TD>pmRA</TD><TD>pmDE</TD><TD>EpRAm</TD><TD>EpDEm</TD><TD>VTmag</TD></TR>
<TR><TD>PPMXL</TD><TD>I/317</TD><TD>RAJ2000</TD><TD>DEJ2000</TD><TD>pmRA</TD><TD>pmDE</TD><TD>epRA</TD><TD>epDE</TD><TD>r2mag</TD></TR>
<TR><TD>APASS</TD><TD>II/336</TD><TD>RAJ2000</TD><TD>DEJ2000</TD><TD></TD><TD></TD><TD></TD><TD></TD><TD>Vmag</TD></TR>
