<?xml version="1.0" encoding="UTF-8"?>
<VOTABLE version="1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.ivoa.net/xml/VOTable/v1.1" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.1 http://www.ivoa.net/xml/VOTable/v1.1">
<DESCRIPTION>
Preferences of VO Catalogues for Munipack
</DESCRIPTION>
<!--
Individual catalogues are inside RESOURCE tag. The parameter 'name'
contains human-centric label.

The parameters FIELDS must contains all required elements.

Notes.
The string in 'name' must contains a phrase which will be found in DESCRIPTION
of the required RESURCE.

http://python4astronomers.github.com/vo/votools.html

-->

<RESOURCE name="SITE">
<TABLE>
<FIELD name="Alias" />
<FIELD name="URL" />
<DATA>
<TABLEDATA>
<TR><TD>CDS, France</TD><TD>http://vizier.cds.unistra.fr</TD></TR>
<TR><TD>Cambridge, UK</TD><TD>http://vizier.ast.cam.ac.uk</TD></TR>
<TR><TD>Adac, Japan</TD><TD>http://vizier.nao.ac.jp</TD></TR>
