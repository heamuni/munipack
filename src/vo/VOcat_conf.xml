<RESOURCE name="CATALOGUE">
<TABLE>
<FIELD name="Alias" ucd="CAT"/>
<FIELD name="ID" ucd="ID"/>
<FIELD name="RA" ucd="POS_EQ_RA" />
<FIELD name="DEC" ucd="POS_EQ_DEC" />
<FIELD name="pmRA" ucd="POS_EQ_PMRA" />
<FIELD name="pmDE" ucd="POS_EQ_PMDEC" />
<FIELD name="EpRA" ucd="TIME_EPOCH_RA" />
<FIELD name="EpDE" ucd="TIME_EPOCH_DEC" />
<FIELD name="mag" ucd="PHOT_MAG" /> <!-- sort -->
<PARAM name="query" value="viz-bin/votable/-A?-source=${ID}&amp;RA=${RA}&amp;DEC=${DEC}&amp;SR=${SR}&amp;VERB=3" />
<DATA>
<TABLEDATA>
<TR><TD>UCAC5</TD><TD>I/340</TD><TD>RAJ2000</TD><TD>DEJ2000</TD><TD>pmRA</TD><TD>pmDE</TD><TD>EpRA</TD><TD>EpDE</TD><TD>f.mag</TD></TR>
